[Unit]
Description=Encrypted R2 database backup and isolated restore verification
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dilshodbektohirov40
WorkingDirectory=/home/dilshodbektohirov40/hr-recruiter/ops
ExecStart=/usr/bin/flock -w 1200 /home/dilshodbektohirov40/hr-recruiter/.deploy.lock /usr/bin/node backup.mjs
TimeoutStartSec=35min
UMask=0077
