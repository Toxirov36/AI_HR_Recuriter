[Unit]
Description=Renew HR Recruiter HTTPS certificate
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
ExecStart=/usr/bin/certbot renew --cert-name hr-recruiter.ddns.net --quiet --deploy-hook "/www/server/nginx/sbin/nginx -t -c /www/server/nginx/conf/nginx.conf && /www/server/nginx/sbin/nginx -s reload -c /www/server/nginx/conf/nginx.conf"
