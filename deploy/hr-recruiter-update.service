[Unit]
Description=Update the HR Recruiter deployment from GitHub
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
Environment=HOME=/home/deploy
WorkingDirectory=/home/deploy/hr-recruiter/app
ExecStart=/home/deploy/hr-recruiter/app/deploy/update-vps.sh
