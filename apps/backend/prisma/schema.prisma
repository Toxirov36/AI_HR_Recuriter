generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
enum UserRole {
  ADMIN
  HR
  RECRUITER
  INTERVIEWER
}

enum PlatformRole {
  SUPER_ADMIN
}
enum VacancyStatus {
  DRAFT
  ACTIVE
  CLOSED
}
enum ApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}
enum CandidateSource {
  WEBSITE
  TELEGRAM
  MANUAL
  REFERRAL
}
enum ResumeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum PublicationPlatform {
  TELEGRAM
  HEADHUNTER
}
enum PublicationStatus {
  PENDING_APPROVAL
  QUEUED
  SENDING
  PUBLISHED
  FAILED
  UNKNOWN
  STALE
  CLOSED
}
enum ChannelDiscoveryStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
enum TelegramApplyStep {
  PRIVACY
  AI_CONSENT
  ASSESSMENT
  CONTACT_PHONE
  DOCUMENT
}
model Company {
  id Int @id @default(autoincrement())
  name String
  isActive Boolean @default(true)
  users User[]
  vacancies Vacancy[]
  candidates Candidate[]
  applications Application[]
  invitations Invitation[]
  telegramConnections TelegramBusinessConnection[]
  telegramConnectRequests TelegramConnectRequest[]
  telegramAdminPairings TelegramAdminPairing[]
  telegramAdminLinks TelegramAdminLink[]
  retentionDays Int @default(180)
  auditLogs AuditLog[]
  telegramChannels TelegramChannel[]
  hhConnection HeadHunterConnection?
  publications VacancyPublication[]
  channelDiscoveryRuns TelegramChannelDiscovery[]
  telegramApplySessions TelegramApplySession[]
  recommendations VacancyRecommendation[]
  createdAt DateTime @default(now())
}
model User {
  id Int @id @default(autoincrement())
  fullName String
  email String? @unique
  phone String? @unique
  password String
  googleSubject String? @unique
  role UserRole @default(HR)
  isActive Boolean @default(true)
  platformRole PlatformRole?
  mfaEnabled Boolean @default(false)
  mfaSecret String?
  mfaRecoveryCodes String[] @default([])
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  telegramConnections TelegramBusinessConnection[]
  telegramConnectRequests TelegramConnectRequest[]
  telegramAdminPairings TelegramAdminPairing[]
  telegramAdminLink TelegramAdminLink?
  hhConnections HeadHunterConnection[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  @@index([companyId])
}
model PlatformAuditLog {
  id Int @id @default(autoincrement())
  actorId Int
  actorName String
  companyId Int
  companyName String
  action String
  reason String
  previousActive Boolean?
  newActive Boolean?
  createdAt DateTime @default(now())
  @@index([createdAt, id])
  @@index([companyId, createdAt])
}

model CompanyFileCleanup {
  id Int @id @default(autoincrement())
  companyId Int
  companyName String
  objectKey String @unique
  createdAt DateTime @default(now())
  @@index([companyId])
}

model Invitation {
  id Int @id @default(autoincrement())
  email String
  tokenHash String @unique
  role UserRole @default(HR)
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  expiresAt DateTime
  usedAt DateTime?
  @@index([companyId])
}
model Vacancy {
  id Int @id @default(autoincrement())
  publicToken String @unique @default(uuid())
  title String
  description String
  status VacancyStatus @default(ACTIVE)
  department String?
  location String?
  workModel String?
  employmentType String?
  seniority String?
  metadataReviewRequired Boolean @default(false)
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  requirements Requirement[]
  applications Application[]
  recommendations VacancyRecommendation[]
  publications VacancyPublication[]
  channelDiscoveryRuns TelegramChannelDiscovery[]
  telegramApplySessions TelegramApplySession[]
  hhAreaId String?
  hhProfessionalRoleId String?
  hhExperienceId String?
  hhEmploymentId String?
  hhScheduleId String?
  hhSearchCount Int?
  hhSearchedAt DateTime?
  hhSearchError String?
  assessmentQuestions Json?
  assessmentRevision Int?
  assessmentEditVersion Int @default(0)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, companyId])
  @@index([companyId, createdAt])
}
model TelegramChannel {
  id Int @id @default(autoincrement())
  companyId Int
  chatId String @unique
  title String
  username String?
  enabled Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  publications VacancyPublication[]
  createdAt DateTime @default(now())
  @@index([companyId])
}
model TelegramChannelDiscovery {
  id Int @id @default(autoincrement())
  companyId Int
  vacancyId Int
  vacancyRevision Int
  status ChannelDiscoveryStatus @default(QUEUED)
  results Json?
  error String?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId, companyId], references: [id, companyId], onDelete: Cascade)
  @@index([companyId, vacancyId, createdAt])
  @@index([status, updatedAt])
}
model HeadHunterConnection {
  companyId Int @id
  connectedByUserId Int
  employerId String
  managerId String
  accessTokenEncrypted String
  refreshTokenEncrypted String
  expiresAt DateTime
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connectedBy User @relation(fields: [connectedByUserId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}
model VacancyPublication {
  id Int @id @default(autoincrement())
  companyId Int
  vacancyId Int
  platform PublicationPlatform
  destinationKey String
  channelId Int?
  status PublicationStatus @default(PENDING_APPROVAL)
  approvedRevision Int?
  approvedPayload Json?
  externalId String?
  externalUrl String?
  error String?
  approvedById Int?
  approvedAt DateTime?
  publishedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId, companyId], references: [id, companyId], onDelete: Cascade)
  channel TelegramChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([vacancyId, platform, destinationKey])
  @@index([companyId, status])
}
model TelegramApplySession {
  telegramUserId String @id
  companyId Int
  vacancyId Int
  step TelegramApplyStep
  privacyAcceptedAt DateTime?
  aiConsentAt DateTime?
  currentQuestionIndex Int @default(0)
  answers Json?
  assessmentQuestions Json?
  assessmentRevision Int?
  phone String?
  expiresAt DateTime
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId, companyId], references: [id, companyId], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  @@index([companyId, expiresAt])
}
model Requirement {
  id Int @id @default(autoincrement())
  name String
  description String?
  required Boolean @default(true)
  vacancyId Int
  vacancy Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  @@index([vacancyId])
}
model Candidate {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  fullName String
  email String?
  phone String?
  telegramUserId String?
  telegramUsername String?
  source CandidateSource @default(WEBSITE)
  publicSubmittedAt DateTime?
  privacyAcceptedAt DateTime?
  aiConsentAt DateTime?
  mergedIntoId Int?
  mergedInto Candidate? @relation("CandidateMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedCandidates Candidate[] @relation("CandidateMerges")
  resumeName String?
  resumeMime String?
  resumeData Bytes?
  resumeObjectKey String? @unique
  resumeSize Int?
  resumeText String?
  resumeRevision Int @default(0)
  skills Json?
  experience Json?
  education Json?
  languages Json?
  parsedResume Json?
  isAnonymized Boolean @default(false)
  anonymizedAt DateTime?
  isOcrProcessed Boolean @default(false)
  applications Application[]
  recommendations VacancyRecommendation[]
  resumes Resume[]
  events CandidateEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([id, companyId])
  @@unique([companyId, telegramUserId])
  @@index([companyId, createdAt])
  @@index([companyId, mergedIntoId])
}
model Resume {
  id Int @id @default(autoincrement())
  companyId Int
  candidateId Int
  fileName String
  objectKey String? @unique
  mimeType String?
  fileSize Int?
  telegramFileId String?
  status ResumeStatus @default(PENDING)
  rawText String?
  error String?
  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, status])
  @@index([candidateId, createdAt])
}
model CandidateEvent {
  id Int @id @default(autoincrement())
  companyId Int
  candidateId Int
  type String
  label String
  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([candidateId, createdAt])
}
model TelegramBusinessConnection {
  id String @id
  companyId Int?
  userId Int?
  telegramUserId BigInt
  telegramUsername String?
  userChatId BigInt
  canReply Boolean @default(false)
  canReadMessages Boolean @default(false)
  enabled Boolean @default(true)
  screeningAlertsEnabled Boolean @default(true)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
  @@index([userId])
  @@index([telegramUserId])
}
model TelegramAdminPairing {
  id Int @id @default(autoincrement())
  companyId Int
  userId Int
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([companyId, userId, expiresAt])
}
model TelegramAdminLink {
  userId Int @id
  companyId Int
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId String @unique
  telegramUsername String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId])
}
model TelegramConnectRequest {
  id Int @id @default(autoincrement())
  companyId Int
  userId Int
  token String @unique
  telegramUserId String?
  telegramUsername String?
  expiresAt DateTime
  used Boolean @default(false)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([token])
  @@index([companyId])
  @@index([telegramUserId])
}
model TelegramWebhookUpdate {
  updateId BigInt @id
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Application {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id])
  vacancyId Int
  candidateId Int
  aiConsentGranted Boolean?
  vacancy Vacancy @relation(fields: [vacancyId, companyId], references: [id, companyId], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  analysis Json?
  interviewQuestions Json?
  interviewReview Json?
  assessmentScore Int?
  assessmentResult Json?
  reviewRevision Int @default(0)
  stageHistory ApplicationStageChange[]
  screeningAlerts TelegramScreeningAlert[]
  analyzedResumeRevision Int?
  analyzedVacancyRevision Int?
  status ApplicationStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([vacancyId, candidateId])
  @@index([companyId, status])
}

model TelegramScreeningAlert {
  id Int @id @default(autoincrement())
  companyId Int
  applicationId Int
  chatId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  lastError String?
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@unique([applicationId, chatId])
  @@index([status, nextAttemptAt])
  @@index([companyId, status])
}
model ApplicationStageChange {
  id Int @id @default(autoincrement())
  applicationId Int
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus ApplicationStatus?
  toStatus ApplicationStatus
  actorId Int
  actorName String
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}

model AuditLog {
  id Int @id @default(autoincrement())
  companyId Int
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId Int?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorName String
  actorRole String
  action String
  resourceType String
  resourceId String
  details Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@index([userId])
}

model VacancyRecommendation {
  id Int @id @default(autoincrement())
  companyId Int
  vacancyId Int
  candidateId Int
  matchScore Int
  mandatoryScore Int
  optionalScore Int
  analysis Json
  vacancyRevision Int
  resumeRevision Int
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vacancy Vacancy @relation(fields: [vacancyId, companyId], references: [id, companyId], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vacancyId, candidateId])
  @@index([companyId, vacancyId, matchScore])
  @@index([candidateId])
}
