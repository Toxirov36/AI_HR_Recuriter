NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Google Calendar for interview scheduling (Meet links). Redirect URI: https://<domain>/api/integrations/google-calendar/callback
# Key: openssl rand -base64 32
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_TOKEN_ENCRYPTION_KEY=

POSTGRES_USER=recruiter
POSTGRES_PASSWORD=
POSTGRES_DB=recruiter
POSTGRES_PORT=5433
DATABASE_URL=postgresql://recruiter:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5433/recruiter?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:6379

JWT_SECRET=

# Text AI: DeepSeek when DEEPSEEK_API_KEY is set (AI_PROVIDER=auto|deepseek|gemini), otherwise Gemini.
# Voice transcription, OCR and embeddings still use Gemini (GEMINI_API_KEY).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_TIMEOUT_MS=60000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Where uploaded CVs are kept: auto (R2 when configured, otherwise the database),
# local (a directory on the server; Docker uses the uploads_data volume) or r2.
STORAGE_DRIVER=auto
LOCAL_STORAGE_DIR=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/v1/integrations/telegram/webhook
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Local: .local/telegram-discovery/session; Docker: /run/secrets/telegram-discovery/session
TELEGRAM_USER_SESSION_FILE=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_CALLBACK_URL=https://api.example.com/api/integrations/headhunter/callback
HH_TOKEN_ENCRYPTION_KEY=
HH_USER_AGENT=

# SMTP: Gmail uses the full email address and a Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
